# Secrets. Required; the app refuses to start without them.
JWT_SECRET=change-me-to-at-least-32-random-bytes-xxxxx
SITE_PASSWORD=change-me

# Storage
DATA_DIR=/data
MAX_MEDIA_BYTES=80000000000

# HTTP
ALLOWED_ORIGIN=http://localhost:5173
SCRAPER_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/140.0.0.0 Safari/537.36

# LLM (Phase 8)
LLM_ENABLED=true
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3.1-flash-lite
OPENROUTER_MODEL_FALLBACK=qwen/qwen3-vl-32b-instruct

# Web push (Phase 9)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Optional Crawl4AI sidecar. Empty disables it.
RENDER_SERVICE_URL=

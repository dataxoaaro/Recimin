# Secrets. Required; the app refuses to start without them.
# Copy this to .env. There is only one, it is gitignored, and
# scripts/deploy.sh uploads it to the server unchanged — so config is edited
# HERE, never over ssh. A copy edited on the server looks applied and is not.
#
# DATA_DIR, ALLOWED_ORIGIN and MAX_MEDIA_BYTES below are the LOCAL values.
# The server overrides all three in docker-compose.yml under `environment:`,
# which takes precedence over `env_file:`.
#
# deploy.sh refuses to run if any key below is missing from .env or still
# holds a placeholder, so leave the change-me values obviously fake.

JWT_SECRET=change-me-to-at-least-32-random-bytes-xxxxx
SITE_PASSWORD=change-me

# Storage
DATA_DIR=/data
MAX_MEDIA_BYTES=80000000000

# HTTP
ALLOWED_ORIGIN=http://localhost:5173
SCRAPER_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/140.0.0.0 Safari/537.36

# LLM (Phase 8)
LLM_ENABLED=true
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3.7-flash
OPENROUTER_MODEL_FALLBACK=google/gemini-3.5-flash-lite
# low | medium | high. Medium is Google's default and correct for extraction.
OPENROUTER_REASONING_EFFORT=medium

# Web push (Phase 9)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Cloudflare Tunnel. Paste the token from the Zero Trust dashboard; leaving it
# empty keeps the tunnel service switched off. In the dashboard, point the
# public hostname at http://api:8000 — cloudflared shares the compose network,
# so it reaches the container directly and no host port is exposed.
CLOUDFLARE_TUNNEL_TOKEN=

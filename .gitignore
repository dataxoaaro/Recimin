# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Node
node_modules/

frontend/dev-dist/

# Local data and secrets
# Every .env variant is ignored, including .env.production, which holds the
# real server secrets. Only the example is tracked. The pattern is a catch-all
# rather than a list so a new environment cannot be committed by omission.
.env
.env.*
!.env.example
.dev.vars
data/
backups/

# OS
.DS_Store
.claude/launch.json

# Private: kept on disk, never in the public repository.
# claudedocs holds internal design/implementation notes; deploy.sh and the
# tunnel runbook name the actual host this instance runs on.
claudedocs/
scripts/deploy.sh
docs/cloudflare-tunnel.md
